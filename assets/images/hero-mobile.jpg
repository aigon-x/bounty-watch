<svg width="390" height="844" viewBox="0 0 390 844" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Bounty Watch hero background - mobile">
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5F7FA"/>
      <stop offset="50%" stop-color="#E8EEF4"/>
      <stop offset="100%" stop-color="#DCE4ED"/>
    </linearGradient>
    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0066CC" stop-opacity="0.08"/>
      <stop offset="50%" stop-color="#FFCC00" stop-opacity="0.06"/>
      <stop offset="100%" stop-color="#004C99" stop-opacity="0.08"/>
    </linearGradient>
    <radialGradient id="glow1" cx="20%" cy="15%" r="45%" fx="20%" fy="15%">
      <stop offset="0%" stop-color="#0066CC" stop-opacity="0.12"/>
      <stop offset="70%" stop-color="#0066CC" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow2" cx="85%" cy="35%" r="40%" fx="85%" fy="35%">
      <stop offset="0%" stop-color="#FFCC00" stop-opacity="0.1"/>
      <stop offset="70%" stop-color="#FFCC00" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow3" cx="50%" cy="85%" r="50%" fx="50%" fy="85%">
      <stop offset="0%" stop-color="#004C99" stop-opacity="0.08"/>
      <stop offset="70%" stop-color="#004C99" stop-opacity="0"/>
    </radialGradient>
    <pattern id="gridPattern" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0066CC" stroke-width="0.5" stroke-opacity="0.04"/>
    </pattern>
    <filter id="subtleNoise" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" stitchTiles="stitch" result="noise"/>
      <feColorMatrix type="saturate" values="0"/>
      <feComponentTransfer>
        <feFuncA type="table" tableValues="0 0.02"/>
      </feComponentTransfer>
      <feBlend in="SourceGraphic" mode="overlay"/>
    </filter>
  </defs>
  
  <rect width="390" height="844" fill="url(#bgGradient)"/>
  <rect width="390" height="844" fill="url(#accentGradient)"/>
  <ellipse cx="78" cy="127" rx="180" ry="140" fill="url(#glow1)"/>
  <ellipse cx="332" cy="295" rx="160" ry="120" fill="url(#glow2)"/>
  <ellipse cx="195" cy="717" rx="200" ry="160" fill="url(#glow3)"/>
  <rect width="390" height="844" fill="url(#gridPattern)"/>
  <rect width="390" height="844" filter="url(#subtleNoise)"/>
  
  <g opacity="0.03">
    <path d="M-50,400 Q195,200 440,400 T830,400" fill="none" stroke="#0066CC" stroke-width="2" stroke-dasharray="8,12"/>
    <path d="M-50,520 Q195,320 440,520 T830,520" fill="none" stroke="#004C99" stroke-width="1.5" stroke-dasharray="12,8"/>
    <path d="M-50,640 Q195,440 440,640 T830,640" fill="none" stroke="#FFCC00" stroke-width="1" stroke-dasharray="6,14"/>
  </g>
  
  <circle cx="95" cy="180" r="3" fill="#0066CC" opacity="0.15">
    <animate attributeName="opacity" values="0.15;0.3;0.15" dur="4s" repeatCount="indefinite"/>
  </circle>
  <circle cx="285" cy="140" r="2" fill="#FFCC00" opacity="0.15">
    <animate attributeName="opacity" values="0.15;0.25;0.15" dur="3.5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="340" cy="380" r="2.5" fill="#004C99" opacity="0.12">
    <animate attributeName="opacity" values="0.12;0.22;0.12" dur="5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="60" cy="520" r="2" fill="#0066CC" opacity="0.1">
    <animate attributeName="opacity" values="0.1;0.2;0.1" dur="4.5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="320" cy="680" r="3" fill="#FFCC00" opacity="0.1">
    <animate attributeName="opacity" values="0.1;0.18;0.1" dur="3.8s" repeatCount="indefinite"/>
  </circle>
</svg>