<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Jane Doe - Team Member Portrait">
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0066CC"/>
      <stop offset="100%" stop-color="#004C99"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000000" flood-opacity="0.15"/>
    </filter>
  </defs>
  
  <!-- Background circle -->
  <circle cx="200" cy="200" r="180" fill="url(#bgGradient)" filter="url(#shadow)"/>
  
  <!-- Decorative accent ring -->
  <circle cx="200" cy="200" r="185" fill="none" stroke="#FFCC00" stroke-width="3" stroke-dasharray="8,12" opacity="0.6"/>
  
  <!-- Silhouette: head -->
  <circle cx="200" cy="155" r="55" fill="#FFFFFF" opacity="0.9"/>
  
  <!-- Silhouette: shoulders -->
  <ellipse cx="200" cy="320" rx="110" ry="60" fill="#FFFFFF" opacity="0.9"/>
  
  <!-- Silhouette: neck connector -->
  <path d="M145 210 Q160 240 165 270 L235 270 Q240 240 255 210 Z" fill="#FFFFFF" opacity="0.9"/>
  
  <!-- Initials -->
  <text x="200" y="168" font-family="Inter, system-ui, sans-serif" font-size="48" font-weight="600" fill="#004C99" text-anchor="middle" dominant-baseline="middle">JD</text>
  
  <!-- Name label -->
  <text x="200" y="365" font-family="Inter, system-ui, sans-serif" font-size="18" font-weight="500" fill="#FFFFFF" text-anchor="middle" dominant-baseline="middle" opacity="0.95">Jane Doe</text>
  
  <!-- Role label -->
  <text x="200" y="388" font-family="Inter, system-ui, sans-serif" font-size="13" font-weight="400" fill="#FFCC00" text-anchor="middle" dominant-baseline="middle" opacity="0.9">Senior Security Engineer</text>
</svg>